/target
**/target
node_modules/
dist/
.DS_Store
*.log
src-tauri/gen/
.env
*.iso
# tauri app build artifacts
app/dist/
app/node_modules/
app/src-tauri/target/
app/src-tauri/gen/

# Credentials — never commit these (push protection is the backstop, not the plan)
*.pem
*.key
*.p12
*.pfx
id_rsa*
.env.*
secrets.*

# Disk images and Windows install payloads (huge, and often machine-specific)
*.img
*.vhd
*.vhdx
*.wim
*.esd
*.swm

# …except test fixtures: small, and the tests will not compile without them.
# The rules above are extension-wide, so a fixture lands in .gitignore's lap the
# moment it is named after the format it tests. `git add -A` skips ignored files
# without a word, so this went unnoticed until a clean checkout failed to build.
!crates/core/fixtures/**

# Editor / OS local state
.vscode/
.idea/
*.swp
Thumbs.db
